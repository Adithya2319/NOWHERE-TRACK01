# Server-only configuration. Never put MiniMoth keys in VITE_ variables.
# Compatibility value: demo selects persistent local accounts, without phone verification.
# Select provider for verified phone sign-in; it requires server credentials.
AUTH_MODE=demo
MINIMOTH_API_KEY=
HOST=127.0.0.1
PORT=4000
DEV_FRONTEND_PORT=5174
DB_PATH=data/campus360.sqlite
# Development adds exact loopback origins on 5173, 5174, DEV_FRONTEND_PORT and PORT.
# Production uses ONLY the explicitly configured HTTPS origins below.
PUBLIC_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4000,http://127.0.0.1:4000
COOKIE_SECURE=false
TRUST_PROXY=false
# Optional fixed sample date for initial data; otherwise seed uses the actual college date.
# DEMO_DATE=2026-10-16
# Production provider mode: AUTH_MODE=provider, HTTPS PUBLIC_ORIGIN, COOKIE_SECURE=true.
# A public synthetic rehearsal needs explicit ALLOW_DEMO=true with AUTH_MODE=demo.
